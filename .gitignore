# Runtime data — the message logs and metadata DB are never committed.
/data/
/meta.db
*.db

# Build output.
/bin/
/dist/
/doze-kafka

# Go test / coverage artifacts.
*.test
*.out
coverage.*

# Editor / OS noise.
.DS_Store

# Playwright suite: installed packages, boot artefacts and reports.
e2e/node_modules/
e2e/.tmp/
e2e/test-results/
e2e/playwright-report/

# Client-compatibility matrix: dependencies and build output.
compat/**/node_modules/
compat/**/target/
compat/**/.venv/
console/cm6/node_modules/
