# Client versions the compat cells run that no build file of their own pins. Sourced
# by those cells; docs/clients.md's table is held to it (and to java/pom.xml,
# spring/pom.xml and kafkajs/package.json) by docs/versions_test.go.
CONFLUENT_KAFKA_PY=2.16.0
# kcat and the librdkafka it links, built from these commits in CI by
# scripts/install-kcat.sh (Ubuntu's kcat links librdkafka 2.3, and kcat-telemetry
# needs 2.5 or newer). The script reads these lines and fails unless the kcat it
# built reports this librdkafka.
KCAT_VERSION=1.7.1
KCAT_COMMIT=9ca33cdbb8cb1f762d118ef76f96711125ccb091
LIBRDKAFKA_VERSION=2.15.1
LIBRDKAFKA_COMMIT=c58bbed850ebe1cc493259d11e4de6ca930d5120
