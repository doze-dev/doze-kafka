      "label": "define-interval-5s",
      "conn": "admin",
      "api": "IncrementalAlterConfigs",
      "version": 1,
      "request": {
        "Resources": [
          {
            "Configs": [
              {
                "Name": "metrics",
                "Op": "SET",
                "Value": "org.apache.kafka."
              },
              {
                "Name": "interval.ms",
                "Op": "SET",
                "Value": "5000"
              }
            ],
            "ResourceName": "conformance",
            "ResourceType": "CLIENT_METRICS"
          }
        ],
        "ValidateOnly": false
      },
      "response": {
        "Resources": [
          {
            "ErrorCode": 0,
            "ErrorMessage": null,
            "ResourceName": "conformance",
            "ResourceType": "CLIENT_METRICS"
