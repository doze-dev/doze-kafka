{
  "scenario": "telemetry-subscription-change",
  "kafka": "apache/kafka:4.3.1",
  "steps": [
    {
      "label": "define-interval-1s",
      "api": "IncrementalAlterConfigs",
      "version": 1,
      "request": {
        "Resources": [
          {
            "Configs": [
              {
                "Name": "metrics",
                "Op": "SET",
                "Value": "org.apache.kafka."
              },
              {
                "Name": "interval.ms",
                "Op": "SET",
                "Value": "1000"
              }
            ],
            "ResourceName": "conformance",
            "ResourceType": "CLIENT_METRICS"
          }
        ],
        "ValidateOnly": false
      },
      "response": {
        "Resources": [
          {
            "ErrorCode": 0,
            "ErrorMessage": null,
            "ResourceName": "conformance",
            "ResourceType": "CLIENT_METRICS"
          }
        ],
        "ThrottleMillis": 0
      }
    },
    {
      "label": "subscribe",
      "api": "GetTelemetrySubscriptions",
      "version": 0,
      "request": {
        "ClientInstanceID": "\u003czero-id\u003e"
      },
      "response": {
        "AcceptedCompressionTypes": [
          4,
          3,
          1,
          2
        ],
        "ClientInstanceID": "\u003cinstance:1\u003e",
        "DeltaTemporality": true,
        "ErrorCode": 0,
        "PushIntervalMillis": 1000,
        "RequestedMetrics": [
          "org.apache.kafka."
        ],
        "SubscriptionID": "\u003csubscription:1\u003e",
        "TelemetryMaxBytes": 1048576,
        "ThrottleMillis": 0
      }
    },
    {
