{
  "name": "doze-kafka-console-editor",
  "private": true,
  "type": "module",
  "description": "Source of console/static/cm6.min.js: the CodeMirror 6 pieces the console's editor uses, bundled once. Not embedded in the binary.",
  "scripts": {
    "build": "bun build entry.js --minify --target=browser --format=iife --outfile=../static/cm6.min.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5"
  }
}
